# Copy this file to .env and fill in real values for local development.

# HTTP port the server listens on.
PORT=4000

# The frontend's origin — used both for CORS and to build magic-link URLs emailed to players.
APP_URL=http://localhost:5173

# Postgres connection string (Neon dashboard -> your project -> Connect -> connection string).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Resend API key (resend.com -> API Keys). Leave blank during local development: with no key
# set, magic links are printed to the server console instead of emailed, so the whole auth flow
# is testable without an email account.
RESEND_API_KEY=

# Any long random string — signs session/pending-profile tokens. Generate one with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=change-me-to-a-long-random-string
