# Copy this file to .env and fill in real values for local development.

# HTTP port the server listens on.
PORT=4000

# The frontend's origin — used for CORS and to determine whether cross-site session cookies
# need SameSite=None (production, different domains) or Lax (local, same site).
APP_URL=http://localhost:5173

# Postgres connection string (Neon dashboard -> your project -> Connect -> connection string).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Any long random string — signs session tokens. Generate one with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=change-me-to-a-long-random-string
